{
  "name": "@silapor/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "echo \"build: @silapor/database (stub, no emit yet)\"",
    "db:generate": "drizzle-kit generate",
