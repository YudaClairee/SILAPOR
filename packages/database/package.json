  },
  "dependencies": {
    "@silapor/domain": "workspace:*",
    "@silapor/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "5.0.3"
  }
}
