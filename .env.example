# Local runtime config (Task 6, Phase 1 step 22 pilot). Copy to `.env`
# for local dev. No secrets here — values are dev defaults only.
# Wrangler/Cloudflare bindings are deferred until after the pilot (no
# wrangler file is committed in this phase).

# PostgreSQL connection string (docker compose up provides this DB).
DATABASE_URL=postgres://silapor:silapor@localhost:5432/silapor

# Web dev server port (apps/web `vite dev`, default 3000).
PORT=3000

# Filesystem attachment storage root (packages/storage default).
STORAGE_DIR=./.data/attachments

# S3-compatible endpoint for the future Garage/R2 adapter (unused by the
# current filesystem adapter; kept so the config key is stable).
# Garage S3 API provided by `docker compose up` (service `garage`).
STORAGE_ENDPOINT=http://localhost:3900

# Garage dev defaults (single-node auto-setup, see infra/garage/garage.toml).
# The S3 adapter (Phase 4) will read these; dev-only, replace on shared hosts.
GARAGE_DEFAULT_ACCESS_KEY=GKaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
GARAGE_DEFAULT_SECRET_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
GARAGE_DEFAULT_BUCKET=silapor

# Shared worker liveness beat file (web + worker run from the repo root in
# the pilot, or set an absolute shared path).
WORKER_BEAT_FILE=./.data/worker-beat.json

# OpenRouter API key for submit-time AI verification (server-only secret).
# Leave EMPTY in local dev — with no key the AI verify holds the report for
# admin review (DOWN) instead of rejecting it. Never commit a real key here.
OPENROUTER_API_KEY=

# Pinned OpenRouter model slug for submit-time verification. Empty means the
# verify call holds (DOWN) instead of running — set the exact slug in prod.
OPENROUTER_MODEL=
