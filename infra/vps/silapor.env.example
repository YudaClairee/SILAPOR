# Template env production SILAPOR (VPS pilot). TANPA SECRET.
# File asli: /etc/silapor/silapor.env  — owner silapor, mode 0600.
# JANGAN commit file asli. Format: KEY=value tanpa tanda kutip dan tanpa spasi
# (dibaca oleh systemd EnvironmentFile, docker compose --env-file, dan bash).

NODE_ENV=production
PORT=3000

# ---------- PostgreSQL (Docker di VPS) ----------
# Wajib, minimal 32 karakter acak. Gunakan HEX agar aman di dalam URL:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
# Ganti <POSTGRES_PASSWORD> dengan nilai yang sama persis seperti di atas.
DATABASE_URL=postgres://silapor:<POSTGRES_PASSWORD>@127.0.0.1:5432/silapor

# ---------- Lampiran: Cloudflare R2 (bucket privat) ----------
STORAGE_ADAPTER=s3
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=silapor-pilot
# Dari R2 → Manage API tokens (Object Read & Write, hanya bucket silapor-pilot)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---------- Worker ----------
# Path absolut; harus sama untuk web (pembaca) dan worker (penulis).
WORKER_BEAT_FILE=/var/lib/silapor/worker-beat.json

# ---------- Auth ----------
# Satu-satunya nilai pilot. Mock SSO tidak memverifikasi password, sehingga
# hostname WAJIB berada di belakang Cloudflare Access.
AUTH_PROVIDER=mock

# ---------- AI verification (dijalankan web saat submit) ----------
# Kosong = verifikasi AI di-hold, laporan masuk antrean review admin.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
AI_VERIFY_TIMEOUT_MS=10000
