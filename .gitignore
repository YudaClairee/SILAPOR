# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
dist/
build/
.output/
.out/
.tanstack/

# TanStack Router generated route tree is intentionally TRACKED in this repo
# (see apps/web/src/router.tsx: "checked in so `tsc --noEmit` passes on a fresh
# clone"). Do NOT ignore it.

# TypeScript
*.tsbuildinfo
*.tsbuildlog

# Moon
.moon/cache/

# pnpm
.pnpm-store/
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
blob-report/

# Local filesystem attachment storage (packages/storage default STORAGE_DIR).
.data/

# Git worktrees checked out under the repo (local only)
.worktrees/

# Env / secrets — never commit real values, only .env.example
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~
.vim/

# Docker / infra local state (keep compose file + garage.toml, ignore runtime data)
garage-data/
garage-meta/
postgres-data/
*.pem
*.key

# Local PDFs / personal notes occasionally dropped in repo root — uncomment if you
# want to stop tracking the room-code PDF:
# *.pdf

# Skills / agent local caches (keep skills-lock.json tracked)
.agents/
.claude/
.opencode/

